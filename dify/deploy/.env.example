# 忘川酒馆 · 引擎与记忆层的本地配置
# 复制成 deploy/.env 后按需修改；这个文件里不放任何真实密钥。

# ---- seekdb（Dify compose 里那个 seekdb 容器，端口映射到宿主机）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=difyai123456
SEEKDB_DATABASE=test

# ---- PowerContext（记忆层；POWERCONTEXT_ENABLED=0 时引擎自动降级）
POWERCONTEXT_URL=http://127.0.0.1:8010
POWERCONTEXT_TOKEN=tavern-local-token
POWERCONTEXT_ENABLED=1
POWERCONTEXT_SCOPE_PREFIX=wangchuan-tavern

# ---- 玩法参数
TAVERN_START_COINS=20
TAVERN_MAX_TURNS=40
TAVERN_RECALL_PER_NPC=3
TAVERN_GOSSIP=1
TAVERN_PORT=9100
